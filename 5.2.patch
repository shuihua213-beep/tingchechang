+services:
+  mysql:
+    image: mysql:5.7
+    restart: unless-stopped
+    environment:
+      MYSQL_ROOT_PASSWORD: ${CF_MYSQL_PASSWORD}
+      MYSQL_DATABASE: ${CF_MYSQL_DATABASE}
+      MYSQL_USER: ${CF_MYSQL_USERNAME}
+      MYSQL_PASSWORD: ${CF_MYSQL_PASSWORD}
+    ports:
+      - "3306:3306"
