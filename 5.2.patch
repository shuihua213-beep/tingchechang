+      - ./caifeng.sql:/docker-entrypoint-initdb.d/01-caifeng.sql:ro
+
+  redis:
+    image: redis:6.2-alpine
+    restart: unless-stopped
+    command: ["redis-server", "--appendonly", "yes"]
+    ports:
+      - "6379:6379"
+    volumes:
+      - redis-data:/data
+
+  mongodb:
+    image: mongo:4.4
+    restart: unless-stopped
+    environment:
+      MONGO_INITDB_ROOT_USERNAME: ${CF_MONGODB_USERNAME}
+      MONGO_INITDB_ROOT_PASSWORD: ${CF_MONGODB_PASSWORD}
+    ports:
+      - "27017:27017"
+    volumes:
+      - mongodb-data:/data/db
+
+  zookeeper:
+    image: zookeeper:3.8
+    restart: unless-stopped
+    ports:
+      - "2181:2181"
+
+  fastdfs-tracker:
+    image: ygqygq2/fastdfs-nginx:latest
+    restart: unless-stopped
+    command: tracker
+    ports:
+      - "22122:22122"
+    volumes:
+      - fastdfs-tracker-data:/var/fdfs
+
+  fastdfs-storage:
+    image: ygqygq2/fastdfs-nginx:latest
+    restart: unless-stopped
+    command: storage
+    environment:
+      TRACKER_SERVER: fastdfs-tracker:22122
+    ports:
+      - "23000:23000"
+      - "8888:8080"
+    volumes:
+      - fastdfs-storage-data:/var/fdfs
+    depends_on:
