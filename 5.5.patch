index ce0a73d..acb77b1 100644
--- a/replace.sh
+++ b/replace.sh
@@ -1,24 +1,125 @@
 #!/bin/bash
-IP=$1
-DBIP=$2
-DBUSER=$3
-DBPWD=$4
-RDIP=$5
-RDPWD=$6
-MGIP=$7
