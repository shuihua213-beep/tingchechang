diff --git a/docker-compose.yml b/docker-compose.yml
new file mode 100644
index 0000000..9ff41f8
--- /dev/null
+++ b/docker-compose.yml
@@ -0,0 +1,44 @@
+version: '3.8'
+
+services:
+  mysql:
+    image: mysql:5.7
+    container_name: cf-mysql
+    ports:
+      - "${MYSQL_PORT:-3306}:3306"
+    environment:
+      MYSQL_ROOT_PASSWORD: ${MYSQL_PASSWORD:-root}
+      MYSQL_DATABASE: ${MYSQL_DB:-caifeng}
+      MYSQL_USER: ${MYSQL_USER:-caifeng}
+      MYSQL_PASSWORD: ${MYSQL_PASSWORD:-root}
+    volumes:
+      - ./mysql-data:/var/lib/mysql
+
+  redis:
+    image: redis:6.2
+    container_name: cf-redis
+    ports:
+      - "${REDIS_PORT:-6379}:6379"
+    command: redis-server --requirepass ${REDIS_PASSWORD:-}
+
+  zookeeper:
+    image: zookeeper:3.5
+    container_name: cf-zookeeper
+    ports:
+      - "${ZOOKEEPER_PORT:-2181}:2181"
+
+  mongodb:
+    image: mongo:4.4
+    container_name: cf-mongodb
+    ports:
+      - "${MONGO_PORT:-27017}:27017"
+    environment:
+      MONGO_INITDB_ROOT_USERNAME: ${MONGO_USER:-caifeng}
+      MONGO_INITDB_ROOT_PASSWORD: ${MONGO_PASSWORD:-caifEng666}
+
+  fastdfs-tracker:
+    image: delron/fastdfs
+    container_name: cf-fastdfs-tracker
+    ports:
+      - "${FASTDFS_PORT:-22122}:22122"
+    command: tracker
