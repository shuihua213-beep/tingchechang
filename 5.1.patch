diff --git a/.env.example b/.env.example
new file mode 100644
index 0000000..5c5cf01
--- /dev/null
+++ b/.env.example
@@ -0,0 +1,26 @@
+# 数据库配置
+DB_NAME=caifeng
+DB_URL=jdbc:mysql://mysql:3306/caifeng?characterEncoding=utf-8&useJDBCCompliantTimezoneShift=true&useLegacyDatetimeCode=false&serverTimezone=UTC&useSSL=false
+DB_USER=caifeng
+DB_PASSWORD=your_password
+DB_MAX_ACTIVE=32
+
+# Redis 配置
+REDIS_HOST=redis
+REDIS_PORT=6379
+REDIS_PASSWORD=
+REDIS_DB=0
+REDIS_MAX_ACTIVE=20
+REDIS_MAX_IDLE=20
+REDIS_MIN_IDLE=10
+REDIS_MAX_WAIT=-1
+
+# MongoDB 配置
+MONGODB_URI=mongodb://caifeng:caifEng666@mongodb:27017/?authSource=caifeng
+MONGODB_DB=caifeng
+
+# Dubbo/Zookeeper 配置
+DUBBO_REGISTRY=zookeeper://zookeeper:2181
+
+# FastDFS 配置
+FASTDFS_TRACKER=fastdfs:22122
